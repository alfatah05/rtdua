# SPA + API — tanpa baris sampah di akhir file
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # File/folder yang benar-benar ada → biarkan (termasuk assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua /api/* → thin proxy
    RewriteRule ^api(?:/|$) api/index.php [QSA,L]

    # SPA
    RewriteRule ^ index.html [L]
</IfModule>
