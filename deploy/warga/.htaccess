# SPA + API — tanpa baris sampah di akhir file
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # File/folder yang benar-benar ada → biarkan (termasuk assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Semua /api/* → thin proxy
    RewriteRule ^api(?:/|$) api/index.php [QSA,L]

    # SPA
    RewriteRule ^ index.html [L]
</IfModule>

# index + service worker: jangan di-cache agresif
<IfModule mod_headers.c>
    <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
    # Asset hash Vite boleh cache lama
    <FilesMatch "\.(js|css|woff2|woff|png|jpg|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
