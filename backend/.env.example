# Salin ke .env di server (di luar public_html jika memungkinkan)
CI_ENVIRONMENT = production

app.baseURL = 'https://pengurus-dev.rtdua.my.id/'
app.forceGlobalSecureRequests = true

# Database
database.default.hostname = localhost
database.default.database = NAMA_DB
database.default.username = NAMA_USER
database.default.password = PASSWORD_DB
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Enkripsi NIK (Stage 10) — generate 32 byte hex
# encryption.key = hex2bin:....

# Cookie / session
