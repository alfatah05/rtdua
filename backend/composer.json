{
  "name": "rtdua/backend",
  "description": "rtdua API - CodeIgniter 4",
  "license": "MIT",
  "type": "project",
  "require": {
    "php": "^8.1",
    "codeigniter4/framework": "^4.5"
  },
  "require-dev": {
    "fakerphp/faker": "^1.9",
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php -r \"if (file_exists('vendor/codeigniter4/framework/public/index.php')) { copy('vendor/codeigniter4/framework/public/index.php', 'public/index.php'); }\""
    ],
    "post-update-cmd": [
      "@php -r \"if (file_exists('vendor/codeigniter4/framework/public/index.php')) { copy('vendor/codeigniter4/framework/public/index.php', 'public/index.php'); }\""
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
